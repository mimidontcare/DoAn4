generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

model User {
  id                 Int        @id @default(autoincrement())
  email              String     @unique @db.VarChar(191)
  phone              String     @unique @db.VarChar(20)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  fullName           String     @map("full_name") @db.VarChar(100)
  role               UserRole
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lateCancelCount    Int        @default(0) @map("late_cancel_count")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  staffZones            StaffZone[]
  unavailabilities      StaffUnavailability[]  @relation("StaffUnavailabilities")
  createdUnavailability StaffUnavailability[]  @relation("UnavailabilityCreatedBy")
  addresses             Address[]
  bookings              Booking[]              @relation("BookingCustomer")
  paidConfirmedBookings Booking[]              @relation("BookingPaidConfirmedBy")
  cancelledBookings     Booking[]              @relation("BookingCancelledBy")
  bookingHistories      BookingStatusHistory[]
  assignments           BookingAssignment[]    @relation("AssignmentStaff")
  assignmentsMade       BookingAssignment[]    @relation("AssignmentAssignedBy")

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  // SHA-256 hex của token; token gốc không lưu.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Vùng phục vụ (Z01–Z03) ----------

enum WardType {
  PHUONG
  XA
}

model Province {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(10)
  name     String  @db.VarChar(100)
  // Z02: một thời điểm chỉ một tỉnh hoạt động; bảo đảm ở AreasService.activateProvince.
  isActive Boolean @default(false) @map("is_active")

  zones ServiceZone[]
  wards Ward[]

  @@map("provinces")
}

/**
 * Khu vực do công ty tự chia trong một tỉnh.
 */
model ServiceZone {
  id         Int      @id @default(autoincrement())
  provinceId Int      @map("province_id")
  name       String   @db.VarChar(100)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  province   Province    @relation(fields: [provinceId], references: [id])
  wards      Ward[]
  staffZones StaffZone[]
  bookings   Booking[]

  @@unique([provinceId, name])
  @@map("service_zones")
}

model Ward {
  id          Int      @id @default(autoincrement())
  provinceId  Int      @map("province_id")
  // Z01: phường chưa thuộc khu vực nào thì không đặt được.
  zoneId      Int?     @map("zone_id")
  code        String   @unique @db.VarChar(10)
  name        String   @db.VarChar(100)
  type        WardType
  // Gợi ý tên đơn vị cũ trước sáp nhập 1/7/2025, giúp khách tìm phường mới.
  oldNameHint String?  @map("old_name_hint") @db.VarChar(255)
  isActive    Boolean  @default(false) @map("is_active")

  province  Province     @relation(fields: [provinceId], references: [id])
  zone      ServiceZone? @relation(fields: [zoneId], references: [id])
  addresses Address[]
  bookings  Booking[]

  @@index([provinceId])
  @@index([zoneId])
  @@map("wards")
}

// ---------- Catalog (P, Q01) ----------

enum PricingUnit {
  UNIT
  M2
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(160)
  description String?  @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  // Tiền là số nguyên VND (P03).
  minCharge   Int      @default(0) @map("min_charge")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items    ServiceItem[]
  bookings Booking[]

  @@map("services")
}

model ServiceItem {
  id             Int         @id @default(autoincrement())
  serviceId      Int         @map("service_id")
  name           String      @db.VarChar(150)
  unit           PricingUnit
  unitPrice      Int         @map("unit_price")
  minutesPerUnit Int         @map("minutes_per_unit")
  // Khối lượng là số nguyên (m² làm tròn).
  minQty         Int         @default(0) @map("min_qty")
  maxQty         Int         @map("max_qty")
  isRequired     Boolean     @default(false) @map("is_required")
  sortOrder      Int         @default(0) @map("sort_order")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  service      Service       @relation(fields: [serviceId], references: [id])
  bookingItems BookingItem[]

  @@index([serviceId])
  @@map("service_items")
}

// ---------- Nhân viên (A03, A04) ----------

/**
 * Nhân viên phục vụ những khu vực nào (nhiều-nhiều).
 */
model StaffZone {
  staffId Int @map("staff_id")
  zoneId  Int @map("zone_id")

  staff User        @relation(fields: [staffId], references: [id])
  zone  ServiceZone @relation(fields: [zoneId], references: [id])

  @@id([staffId, zoneId])
  @@index([zoneId])
  @@map("staff_zones")
}

/**
 * Lịch nghỉ do admin nhập; thời gian lưu UTC (T07).
 */
model StaffUnavailability {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?  @db.VarChar(255)
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  staff   User @relation("StaffUnavailabilities", fields: [staffId], references: [id])
  creator User @relation("UnavailabilityCreatedBy", fields: [createdBy], references: [id])

  @@index([staffId, startAt])
  @@map("staff_unavailabilities")
}

// ---------- Địa chỉ khách (C04) ----------

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  wardId       Int      @map("ward_id")
  detail       String   @db.VarChar(255)
  label        String?  @db.VarChar(50)
  contactName  String   @map("contact_name") @db.VarChar(100)
  contactPhone String   @map("contact_phone") @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  // Xóa mềm: booking sau này snapshot địa chỉ nên không phụ thuộc bản ghi này.
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  ward Ward @relation(fields: [wardId], references: [id])

  @@index([userId, isDeleted])
  @@index([wardId])
  @@map("addresses")
}

// ---------- Booking (P02, B01–B04) ----------

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum AdjustmentStatus {
  NONE
  PENDING
  ACCEPTED
  REJECTED
}

enum CancelReason {
  CUSTOMER_REQUEST
  CUSTOMER_NO_SHOW
  NO_STAFF_AVAILABLE
  ADMIN_DECISION
  OTHER
}

enum BookingAction {
  CREATE
  ASSIGN
  DECLINE
  CHECK_IN
  ADJUST
  COMPLETE
  PAYMENT
  CANCEL
  RESCHEDULE
}

model Booking {
  id               Int              @id @default(autoincrement())
  code             String           @unique @db.VarChar(20)
  customerId       Int              @map("customer_id")
  serviceId        Int              @map("service_id")
  wardId           Int              @map("ward_id")
  // Denormalize có chủ đích để lọc và thống kê nhanh.
  zoneId           Int              @map("zone_id")
  // Snapshot (P02): không phụ thuộc bảng giá hay địa chỉ sau khi tạo.
  serviceName      String           @map("service_name") @db.VarChar(150)
  addressText      String           @map("address_text") @db.VarChar(500)
  contactName      String           @map("contact_name") @db.VarChar(100)
  contactPhone     String           @map("contact_phone") @db.VarChar(20)
  // Thời gian lưu UTC (T07).
  startAt          DateTime         @map("start_at")
  endAt            DateTime         @map("end_at")
  manMinutes       Int              @map("man_minutes")
  staffCount       Int              @map("staff_count")
  durationMinutes  Int              @map("duration_minutes")
  // Tiền là số nguyên VND (P03).
  itemsTotal       Int              @map("items_total")
  subtotal         Int
  surcharge        Int              @default(0)
  totalPrice       Int              @map("total_price")
  status           BookingStatus    @default(PENDING)
  paymentStatus    PaymentStatus    @default(UNPAID) @map("payment_status")
  paymentMethod    PaymentMethod?   @map("payment_method")
  paidAt           DateTime?        @map("paid_at")
  paidConfirmedBy  Int?             @map("paid_confirmed_by")
  adjustmentStatus AdjustmentStatus @default(NONE) @map("adjustment_status")
  note             String?          @db.VarChar(500)
  cancelReason     CancelReason?    @map("cancel_reason")
  cancelNote       String?          @map("cancel_note") @db.VarChar(500)
  cancelledBy      Int?             @map("cancelled_by")
  cancelledAt      DateTime?        @map("cancelled_at")
  rescheduleCount  Int              @default(0) @map("reschedule_count")
  version          Int              @default(0)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  customer      User                   @relation("BookingCustomer", fields: [customerId], references: [id])
  service       Service                @relation(fields: [serviceId], references: [id])
  ward          Ward                   @relation(fields: [wardId], references: [id])
  zone          ServiceZone            @relation(fields: [zoneId], references: [id])
  paidConfirmer User?                  @relation("BookingPaidConfirmedBy", fields: [paidConfirmedBy], references: [id])
  canceller     User?                  @relation("BookingCancelledBy", fields: [cancelledBy], references: [id])
  items         BookingItem[]
  histories     BookingStatusHistory[]
  assignments   BookingAssignment[]

  @@index([status, startAt])
  @@index([zoneId, startAt])
  @@index([customerId, status])
  @@map("bookings")
}

model BookingItem {
  id               Int         @id @default(autoincrement())
  bookingId        Int         @map("booking_id")
  serviceItemId    Int         @map("service_item_id")
  nameSnapshot     String      @map("name_snapshot") @db.VarChar(150)
  unit             PricingUnit
  unitPrice        Int         @map("unit_price")
  minutesPerUnit   Int         @map("minutes_per_unit")
  quantity         Int
  // Khối lượng trưởng nhóm đề xuất, chờ khách xác nhận (A01–A05).
  proposedQuantity Int?        @map("proposed_quantity")
  amount           Int

  booking     Booking     @relation(fields: [bookingId], references: [id])
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id])

  @@index([bookingId])
  @@index([serviceItemId])
  @@map("booking_items")
}

/**
 * Nhóm nhân viên của booking (Q04: đúng 1 trưởng nhóm khi CONFIRMED).
 */
model BookingAssignment {
  bookingId  Int      @map("booking_id")
  staffId    Int      @map("staff_id")
  isLeader   Boolean  @default(false) @map("is_leader")
  assignedBy Int      @map("assigned_by")
  assignedAt DateTime @default(now()) @map("assigned_at")

  booking  Booking @relation(fields: [bookingId], references: [id])
  staff    User    @relation("AssignmentStaff", fields: [staffId], references: [id])
  assigner User    @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id])

  @@id([bookingId, staffId])
  @@index([staffId])
  @@map("booking_assignments")
}

/**
 * B02: ghi cả khi trạng thái không đổi (đổi nhóm, điều chỉnh).
 */
model BookingStatusHistory {
  id         Int            @id @default(autoincrement())
  bookingId  Int            @map("booking_id")
  // Null ở bản ghi tạo đơn.
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  action     BookingAction
  // Null khi System thực hiện.
  changedBy  Int?           @map("changed_by")
  note       String?        @db.VarChar(500)
  createdAt  DateTime       @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  actor   User?   @relation(fields: [changedBy], references: [id])

  @@index([bookingId])
  @@map("booking_status_histories")
}
