NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://cleaning_app:CHANGE_ME@localhost:3306/cleaning_booking"
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth — JWT_ACCESS_SECRET bắt buộc, ít nhất 32 ký tự ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10
# Giới hạn riêng cho register/login/refresh (số request mỗi IP trong TTL)
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# Seed (npx prisma db seed) — chỉ script seed đọc; cả hai bị bắt đổi mật khẩu lần đầu
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_PHONE=0900000001
SEED_ADMIN_NAME=Quản trị viên
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=CHANGE_ME
SEED_STAFF_PHONE=0900000002
SEED_STAFF_NAME=Nhân viên mẫu
