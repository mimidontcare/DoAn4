NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://cleaning_app:CHANGE_ME@localhost:3306/cleaning_booking"
FRONTEND_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Auth — JWT_ACCESS_SECRET bắt buộc, ít nhất 32 ký tự ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=30m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=10
# Giới hạn riêng cho register/login/refresh (số request mỗi IP trong TTL)
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5

# Số địa chỉ tối đa mỗi khách (C04)
MAX_ADDRESSES_PER_CUSTOMER=5

# Booking: giờ phục vụ, bước giờ (T01), đặt trước (T02), buffer (T03)
SERVICE_OPEN_HOUR=7
SERVICE_CLOSE_HOUR=20
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_MIN_LEAD_HOURS=3
BOOKING_MAX_ADVANCE_DAYS=14
STAFF_BUFFER_MINUTES=30
# Số nhân viên (Q02, Q03) và giới hạn đơn PENDING mỗi khách (C07)
MAN_MINUTES_PER_STAFF=240
MAX_STAFF_PER_BOOKING=4
MAX_PENDING_BOOKINGS_PER_CUSTOMER=3
# Hủy: còn ít hơn CANCEL_MIN_HOURS thì không hủy được; dưới LATE_CANCEL_HOURS tính hủy muộn
CANCEL_MIN_HOURS_BEFORE_START=2
LATE_CANCEL_HOURS=12
# Nhân viên: cửa sổ check-in quanh giờ bắt đầu, mốc báo khách vắng mặt (S03, S07)
CHECKIN_EARLY_MINUTES=30
CHECKIN_LATE_MINUTES=60
NO_SHOW_AFTER_MINUTES=30
# Điều chỉnh khối lượng tăng tối đa bao nhiêu % phút công lúc đặt (A04)
MAX_ADJUSTMENT_PERCENT=30
# Khoảng ngày tối đa khi nhân viên xem lịch (S01)
STAFF_SCHEDULE_MAX_DAYS=31

# Upload ảnh dịch vụ (POST /admin/uploads): lưu local, phục vụ tại /uploads/<tên file>
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152

# Seed (npx prisma db seed) — chỉ script seed đọc; cả hai bị bắt đổi mật khẩu lần đầu
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_PHONE=0900000001
SEED_ADMIN_NAME=Quản trị viên
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=CHANGE_ME
SEED_STAFF_PHONE=0900000002
SEED_STAFF_NAME=Nhân viên mẫu
